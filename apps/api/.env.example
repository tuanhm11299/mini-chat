# Copy to .env and adjust. Defaults match docker-compose.yml.
PORT=3001
DATABASE_URL=postgres://chat:chat@localhost:5432/mini_chat

# Where the web app runs (used for CORS and cookies).
WEB_ORIGIN=http://localhost:3000

# Use long random strings in production, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
